DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OPENROUTER_API_KEY=
# Concorrência da fila in-process de chamadas OpenRouter (mínimo 1).
OPENROUTER_CONCURRENCY=1
# Máximo de tentativas totais por chamada OpenRouter em 429 (respeita Retry-After).
OPENROUTER_MAX_RETRIES=3
WAKE_WORD=Hey Bot
# Frases extras (separadas por |) aceitas além da WAKE_WORD e dos defaults de "Hey Bot" (ei bot, rei bot).
# WAKE_WORD_ALIASES=Oi Bot|Eae Bot
WAKE_WORD_ALIASES=
