{
  "name": "dontlietome-discordbot",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "imports": {
    "#commands/*": "./dist/commands/*.js",
    "#shared/*": "./dist/shared/*.js"
  },
  "scripts": {
    "sleep": "node -e \"setTimeout(() => process.exit(0), 5000)\"",
    "dev": "tsc --watch --preserveWatchOutput & npm run sleep && nodemon",
    "format": "prettier --config .prettierrc src",
    "format:check": "prettier --config .prettierrc --check src",
    "lint": "eslint --config eslint.config.ts src",
    "lint:fix": "eslint --config eslint.config.ts --fix src",
    "test": "tsc && node --test 'dist/**/*.test.js'",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@openrouter/sdk": "^1.5.139",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "ffmpeg-static": "^5.3.0",
    "p-queue": "^10.0.0",
    "pino": "^10.4.0",
    "prism-media": "^1.3.5",
    "sodium-native": "^5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
